---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/home/Hero.astro'
import Ribbon from '../components/home/Ribbon.astro'
import SelectedWork from '../components/home/SelectedWork.astro'
import Gallery from '../components/home/Gallery.astro'
import Contact from '../components/home/Contact.astro'
import { site } from '../data/site'
import { interests } from '../data/interests'
import { projects } from '../data/projects'
import { patterns } from '../data/patterns'

const { links, privacy } = site

// A card's paper link comes from its project, the one place the URL lives.
const paperOf = (slug: string) => {
  const link = projects.find((p) => p.slug === slug)?.links.find((l) => l.label.startsWith('Paper'))
  if (!link) throw new Error(`No paper link for project "${slug}"`)
  return link.href
}
const cards = patterns.map((card) => (card.paper ? { ...card, href: paperOf(card.paper) } : card))
---

<BaseLayout>
  <Hero
    name={site.name}
    role={site.role}
    location={site.location}
    linkedin={links.linkedin}
  />
  <Ribbon items={interests} />
  <SelectedWork projects={projects.filter((p) => p.featured)} />
  <Gallery cards={cards} />
  <Contact
    name={site.name}
    linkedin={links.linkedin}
    email={privacy.showEmail ? links.email : undefined}
    phone={privacy.showPhone ? site.phone : undefined}
    clearance={privacy.showClearance ? site.clearance : undefined}
  />
</BaseLayout>
