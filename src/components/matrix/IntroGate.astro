---
// The gate for the hero intro. Placed just before the hero, it marks <html>
// with data-js-intro before the hero is parsed, so the first paint already
// knows the intro will run: JavaScript is on and motion is allowed. Under that
// mark the static name and the hero copy start hidden; the matrix shows them
// (data-matrix-ready, then data-copy-shown at about 1.1 s). If the matrix
// never takes over, CSS shows both after 3 s. Without JavaScript, or with
// reduced motion, nothing is hidden. If the matrix bails out early (no 2D
// context, no layout, unreadable palette) it sets data-copy-shown itself, so the
// copy shows at once rather than at the 3 s net.
//
// The intro plays in full once per tab session. Once it has (SEEN_KEY in
// sessionStorage), the gate also marks data-intro-seen and nothing is hidden:
// the name and copy paint lit, and the matrix starts lit in the hold to match.
import { SEEN_KEY } from '../../lib/matrix/visit'
---

<script is:inline define:vars={{ seenKey: SEEN_KEY }}>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const html = document.documentElement
    html.setAttribute('data-js-intro', '')
    try {
      if (sessionStorage.getItem(seenKey) === '1') html.setAttribute('data-intro-seen', '')
    } catch {
      // Storage unavailable: a first visit.
    }
  }
</script>

<style is:global>
  @keyframes intro-safety-net {
    to {
      opacity: 1;
    }
  }

  /* The canvas sweeps the name in from dark; the lit static name would blink. */
  [data-js-intro]:not([data-intro-seen]) [data-name-anchor] {
    opacity: 0;
    animation: intro-safety-net 0s 3s forwards;
  }

  /* The role line and buttons fade in as the name finishes, as the mockup. */
  [data-js-intro]:not([data-intro-seen]) [data-intro-copy] {
    opacity: 0;
    animation: intro-safety-net 0.8s 3s forwards;
  }
  [data-js-intro] [data-copy-shown] [data-intro-copy] {
    opacity: 1;
    animation: none;
    transition: opacity 0.8s ease;
  }

  /* Opacity doesn't block focus, so a button tabbed to early must show. */
  [data-js-intro] [data-intro-copy]:focus-within {
    opacity: 1;
  }
</style>
