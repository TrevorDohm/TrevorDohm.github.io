---
import type { PatternCardData } from '../../data/patterns'
import { cellRect } from '../../lib/patterns/geometry'
import { patternWeights, sweepWeights } from '../../lib/patterns/patterns'

interface Props {
  card: PatternCardData
}

const { card } = Astro.props
const N = 12
const SIZE = 424

// Static frame for JS off and reduced motion: query row in the middle. Weights
// are quantized to the 11 --w{level} colors the gallery section defines, and
// coordinates rounded, to keep the markup small (the clone repeats it).
const weights = sweepWeights(patternWeights(card.id, N), N, N / 2, new Float32Array(N * N))
const round = (v: number) => Number(v.toFixed(2))
let rects = ''
for (let i = 0; i < N; i++) {
  for (let j = 0; j < N; j++) {
    const { x, y, w, r } = cellRect(i, j, N, SIZE)
    const level = Math.round(Math.min(1, weights[i * N + j]) * 10)
    rects += `<rect x="${round(x)}" y="${round(y)}" width="${round(w)}" height="${round(w)}" rx="${round(r)}" style="fill:var(--w${level})"/>`
  }
}
---

<li class="card" data-featured={card.href ? '' : undefined}>
  <div class="map">
    <svg viewBox={`0 0 ${SIZE} ${SIZE}`} aria-hidden="true" set:html={rects} />
    <canvas data-pattern={card.id} width={SIZE} height={SIZE} aria-hidden="true"></canvas>
  </div>
  <div class="meta">
    {
      card.href ? (
        <a class="name" href={card.href} target="_blank" rel="noopener noreferrer">
          {card.name}<span class="arrow" aria-hidden="true"> ↗</span>
        </a>
      ) : (
        <span class="name">{card.name}</span>
      )
    }
    <span class="kind">{card.kind}</span>
  </div>
  <p class="caption">{card.caption}</p>
</li>

<style>
  .card {
    flex-shrink: 0;
    width: 240px;
    padding: 14px;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: var(--color-surface);
    transition:
      transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 0.4s;
  }

  .card:hover,
  .card[data-hover] {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-muted) 18%, var(--color-line));
  }

  .card[data-featured] {
    border-color: color-mix(in srgb, var(--color-accent) 22%, var(--color-line));
  }

  .card[data-featured]:hover,
  .card[data-featured][data-hover] {
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-line));
  }

  .map {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
  }

  .map svg,
  .map canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The live canvas has drawn, so the static frame underneath can go. */
  .card[data-pattern-live] svg {
    visibility: hidden;
  }

  .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-top: 12px;
    line-height: 20px;
  }

  .name {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-foreground);
  }

  a.name:hover {
    color: var(--color-accent);
  }

  .arrow {
    color: var(--color-accent);
  }

  .kind {
    font: 500 11px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--color-muted);
    white-space: nowrap;
  }

  /* Fixed to three lines so every card, and the row, keeps one height. */
  .caption {
    height: calc(3 * 19px);
    margin: 6px 0 0;
    font-size: 13px;
    line-height: 19px;
    color: var(--color-muted);
  }
</style>
