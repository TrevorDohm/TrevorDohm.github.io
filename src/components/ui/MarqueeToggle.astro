---
// The Pause/Play pill for a marquee section. It renders hidden; the marquee
// script shows it and swaps the [data-marquee-label] word. The visually
// hidden text names the section, so a screen reader hears "Pause ribbon".
// The pill itself stays out of sight until it has keyboard focus: a screen
// reader or keyboard user can still stop the motion (WCAG 2.2.2), while
// pointer users slow it by hovering and take it over by dragging.
interface Props {
  /** Visually hidden name of the section it controls. */
  label: string
  /** Where it sits: over the ribbon's top right corner, or beside the gallery heading. */
  placement: 'ribbon' | 'gallery'
}

const { label, placement } = Astro.props
---

<button type="button" data-marquee-toggle hidden class:list={['toggle', placement]}><span data-marquee-label>Pause</span><span class="sr-only"> {label}</span></button>

<style>
  .toggle {
    padding: 6px 12px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    font: 500 12px var(--font-mono);
    cursor: pointer;
  }

  .toggle[hidden] {
    display: none;
  }

  .toggle:not(:focus-visible) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .toggle:hover {
    color: var(--color-foreground);
  }

  .ribbon {
    position: absolute;
    top: 1.5rem;
    right: max(1rem, env(safe-area-inset-right)); /* clear of a landscape notch */
    z-index: 1;
  }

  .gallery {
    margin-bottom: 2rem; /* level with the heading, which has mb-8 */
  }
</style>
