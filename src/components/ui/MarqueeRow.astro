---
// One drifting row of <li> items. The parent element must carry
// data-marquee-root and may hold a button[data-marquee-toggle] (rendered
// hidden). Without the script, or under reduced motion, the row is a static
// list that scrolls sideways; with it, a horizontal drag or swipe scrubs it.
// Items need fixed font-size and line-height (or fixed card sizes) so a font
// swap cannot change the row height. Slot content is cloned, so it must not
// contain id attributes.
interface Props {
  /** Drift speed in px/s. */
  speed: number
  /** Drift right instead of left. */
  reverse?: boolean
  /** Accessible name for the scrollable static row. */
  label: string
  /** Space between items, also used at the seam. */
  gap?: string
}

const { speed, reverse = false, label, gap = '2rem' } = Astro.props
const items = await Astro.slots.render('default')
---

<div
  class="row"
  data-marquee-row
  data-speed={speed}
  data-reverse={reverse || undefined}
  role="region"
  tabindex="0"
  aria-label={label}
  style={`--marquee-gap: ${gap}`}
>
  <ul data-marquee-track><slot /></ul>
  <ul data-marquee-clone inert aria-hidden="true" set:html={items} />
</div>

<style>
  .row {
    display: flex;
    padding-block: 8px; /* room for the 4px card lift */
    overflow-x: auto;
  }

  .row ul {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    width: max-content;
    gap: var(--marquee-gap);
    margin: 0;
    padding: 0 var(--marquee-gap) 0 0;
    list-style: none;
  }

  .row ul[data-marquee-clone] {
    display: none;
  }

  /* Ready mode: only entered once the script has run, never under reduced motion. */
  :global([data-marquee-ready]) .row {
    overflow: hidden; /* fallback for engines without clip */
    overflow: clip; /* not a scroll container, so focusing an item cannot scroll the row */
    --marquee-mask: linear-gradient(
      90deg,
      transparent,
      rgb(0 0 0 / 0.2) 32px,
      black 96px,
      black calc(100% - 96px),
      rgb(0 0 0 / 0.2) calc(100% - 32px),
      transparent
    );
    -webkit-mask-image: var(--marquee-mask);
    mask-image: var(--marquee-mask);
  }

  /* The script scrubs a row on a horizontal drag or swipe; vertical swipes
     still scroll the page. Moving text isn't worth selecting. */
  :global([data-marquee-ready]) .row {
    touch-action: pan-y pinch-zoom;
    cursor: grab;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none; /* no iOS link preview on a long press mid-swipe */
  }

  :global([data-marquee-ready]) .row[data-dragging],
  :global([data-marquee-ready]) .row[data-dragging] :global(*) {
    cursor: grabbing;
  }

  /* A focused item can only be seeked as far as the row's edge, under the fade.
     The script sets data-focus-hold for keyboard focus only, so a click keeps the mask. */
  :global([data-marquee-ready]) .row[data-focus-hold] {
    -webkit-mask-image: none;
    mask-image: none;
  }

  :global([data-marquee-ready]) .row ul[data-marquee-clone] {
    display: flex;
  }

  :global([data-marquee-ready]) .row ul {
    animation: marquee var(--marquee-duration, 0s) linear infinite;
  }

  :global([data-marquee-ready]) .row[data-reverse] ul {
    animation-direction: reverse;
  }
</style>

<script>
  import { init } from '../../lib/marquee'

  document.querySelectorAll<HTMLElement>('[data-marquee-root]').forEach((root) => init(root))
</script>
