---
import { site, nav } from '../data/site'

const path = Astro.url.pathname
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href)
---

<header
  class="fixed top-0 left-0 w-full z-50 bg-background/80 backdrop-blur-sm border-b border-line"
>
  <nav class="section-container py-4" aria-label="Main">
    <div class="flex justify-between items-center">
      <a href="/" class="text-lg font-semibold hover:opacity-70 transition-opacity">
        {site.name}
      </a>

      <!-- Desktop -->
      <div class="hidden md:flex gap-8">
        {nav.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'link-underline py-1 transition-colors',
              isActive(link.href)
                ? 'text-foreground font-medium'
                : 'text-muted hover:text-foreground',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Mobile: plain <details> so the menu works without JavaScript.
           Replaces the legacy Headless UI menu, which would have pulled
           React onto every page just for a hamburger. -->
      <details class="md:hidden relative" id="mobile-menu">
        <summary
          class="list-none cursor-pointer p-2 text-muted hover:text-foreground [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <div
          class="absolute right-0 mt-2 w-48 origin-top-right rounded-lg bg-background border border-line shadow-lg p-1"
        >
          {nav.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'block rounded-md px-3 py-2 text-sm hover:bg-subtle',
                isActive(link.href) ? 'text-foreground font-medium' : 'text-muted',
              ]}
            >
              {link.label}
            </a>
          ))}
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  // Close the mobile menu on outside click or Escape.
  const menu = document.getElementById('mobile-menu') as HTMLDetailsElement | null
  if (menu) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) menu.open = false
    })
  }
</script>
