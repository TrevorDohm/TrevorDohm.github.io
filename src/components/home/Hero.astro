---
import Button from '../ui/Button.astro'
import AttentionMatrix from '../matrix/AttentionMatrix.astro'
import NameMark from '../matrix/NameMark.astro'
import IntroGate from '../matrix/IntroGate.astro'

interface Props {
  name: string
  role: string
  location: string
  linkedin: string
}

const { name, role, location, linkedin } = Astro.props
// One line of facts, "|"-separated; it wraps only between them.
const facts = [...role.split(' | '), location]
---

<IntroGate />

<!-- Exactly one screen tall, so the ribbon starts at the fold. -->
<section
  data-matrix-root
  class="hero relative isolate flex h-svh min-h-[32.5rem] touch-pan-y"
>
  <!-- The CSS backdrop shows without JavaScript and fades out once the matrix
       has drawn its first frame. The matrix and the backdrop's grid lines
       also reach a screen above the hero (the bleed), so the iOS top rubber
       band reveals grid, not flat page. -->
  <div aria-hidden="true" class="hero-backdrop absolute inset-0 -z-10"></div>
  <div aria-hidden="true" class="hero-backdrop hero-bleed absolute inset-x-0 bottom-full -z-10"></div>
  <div aria-hidden="true" class="matrix-layer absolute inset-0 -z-10">
    <AttentionMatrix />
  </div>

  <!-- The block (name, one-row gap, role line, buttons) sits in a wrapper with
       auto block margins, which centre it in the free space without feature
       detection and never push it above the padding when it overflows. It is
       centred at 45% of the hero below the fixed nav: the top padding clears
       the nav (73px tall on phones with the menu button, 65px from md up,
       plus any safe-area inset at the top) and the bottom padding, a tenth
       of what is left, lifts the centre from 50% to 45%. NameMark's height
       cap uses the same numbers. The matrix keeps its glow off the
       [data-matrix-copy] boxes. -->
  <div class="hero-copy section-container relative flex w-full flex-col">
    <h1 class="sr-only">{name}</h1>
    <div class="my-auto">
      <NameMark />
      <p data-matrix-copy data-intro-copy class="role font-mono text-sm text-balance text-muted">
        {facts.map((fact, i) => <>{i > 0 && ' | '}<span class="whitespace-nowrap">{fact}</span></>)}
      </p>
      <div data-matrix-copy data-intro-copy class="mt-6 flex flex-wrap gap-4">
        <Button href="#contact">Get in touch</Button>
        <Button href={linkedin} variant="secondary" external>View LinkedIn</Button>
      </div>
    </div>
  </div>
</section>

<style>
  /* Only the sides are clipped: the matrix layer ends at the hero's bottom
     and nothing else in the hero reaches past it, while the bleed sits above
     its top, where it adds no scroll. */
  .hero {
    overflow-x: clip;
  }

  /* The bleed is one full screen, in whole pixels where round() works so the
     canvas sits on the pixel grid. Without these rules (stale or unsupported
     CSS, or a value that doesn't parse) the matrix layer stays inset 0 on the
     hero, and the JS, which measures where the canvas actually is, draws no
     bleed rows. */
  @supports (top: 1svh) {
    .matrix-layer {
      top: -100svh;
    }
    .hero-bleed {
      height: 100svh;
    }
  }
  @supports (top: round(100svh, 1px)) {
    .matrix-layer {
      top: round(-100svh, 1px);
    }
    .hero-bleed {
      height: round(100svh, 1px);
    }
  }

  .hero-backdrop {
    background:
      radial-gradient(ellipse 55% 50% at 70% 40%, color-mix(in srgb, var(--color-accent) 18%, transparent), transparent 70%),
      radial-gradient(ellipse 40% 40% at 85% 70%, color-mix(in srgb, var(--color-accent-2) 14%, transparent), transparent 70%),
      linear-gradient(var(--color-line) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, var(--color-line) 1px, transparent 1px) 0 0 / 48px 48px;
    mask-image: radial-gradient(ellipse 80% 70% at 60% 50%, black, transparent);
    transition: opacity 0.8s ease;
  }

  /* Above the hero only the grid lines continue, on the hero's lattice
     (counted up from its top edge) and under the ellipse's profile along that
     edge: 0.29 at 60% across, 0 by 16%. */
  .hero-bleed {
    background:
      linear-gradient(var(--color-line) 1px, transparent 1px) 0 100% / 48px 48px,
      linear-gradient(90deg, var(--color-line) 1px, transparent 1px) 0 0 / 48px 48px;
    mask-image: linear-gradient(90deg, transparent 16%, rgb(0 0 0 / 0.15) 30%, rgb(0 0 0 / 0.29) 60%, rgb(0 0 0 / 0.21) 82%, rgb(0 0 0 / 0.05) 100%);
  }

  /* Once the matrix has drawn, its cells replace the backdrop; the backdrop's
     48px lines would otherwise show through the dissolving bottom rows. */
  [data-matrix-ready] .hero-backdrop {
    opacity: 0;
  }

  .hero-copy {
    /* The nav grows by the status bar on notched phones. */
    --hero-nav: calc(4.75rem + env(safe-area-inset-top));
    padding-top: var(--hero-nav);
    padding-bottom: calc((max(100svh, 32.5rem) - var(--hero-nav)) / 10);
    /* A halo in the page color keeps the text readable over bright cells. */
    text-shadow:
      0 0 18px var(--color-background),
      0 0 36px var(--color-background);
  }
  @media (min-width: 48rem) {
    .hero-copy {
      --hero-nav: calc(4.25rem + env(safe-area-inset-top));
    }
  }

  /* Pull the first line's leading up so the text starts one row below DOHM. */
  .role {
    margin-top: -0.2em;
  }
</style>
